@* [EDUCATIONAL NOTE - Lab 1 S1 & Lab 9 S1]:
   Sticky Bottom Audio Player with HTTP 206 Byte-Range Scrubbing:
   1. The HTML5 <audio> element is bound with 'preload="metadata"' to fetch header and duration info
      without immediately downloading the entire audio payload.
   2. DotNetObjectReference: Allows two-way JavaScript Interop so events from HTML5 audio
      ('timeupdate', 'progress', 'canplay') trigger Blazor state re-renders via [JSInvokable].
   3. Dual-Layer Progress Bar:
      - Translucent Cyan layer visualizes HTTP 206 buffered byte chunks in browser cache.
      - Solid Gradient Cyan/Blue layer indicates current playback position.
   4. Next-Track Prefetching: At 75% track duration, the player triggers an HTTP 206 byte-range prefetch
      to eliminate latency when skipping to the next song. *@

@inject PlayerStateService PlayerState
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="audio-player-bar @(PlayerState.CurrentTrack == null ? "idle-player" : "")">
    <!-- Hidden HTML5 Audio Element controlled via JS Interop -->
    <audio @ref="audioElementRef"
           preload="metadata"
           src="@(PlayerState.CurrentTrack != null ? $"http://localhost:5100/api/tracks/{PlayerState.CurrentTrack.Id}/stream" : null)">
    </audio>

    <!-- Dual-Layer Scrubbing Progress Bar -->
    <div class="player-progress-container" @onclick="HandleProgressBarClick" title="Seek track position (HTTP 206 byte-range scrubbing)">
        <div class="progress-buffer-layer" style="width: @($"{Math.Clamp(PlayerState.BufferPercent, 0, 100)}%");"></div>
        <div class="progress-playback-layer" style="width: @($"{PlaybackProgressPercent}%");"></div>
        <div class="progress-scrub-handle" style="left: @($"{PlaybackProgressPercent}%");"></div>
    </div>

    <!-- Left: Track Metadata -->
    <div class="player-track-info">
        @if (PlayerState.CurrentTrack != null)
        {
            <img src="@(string.IsNullOrWhiteSpace(PlayerState.CurrentTrack.CoverArtUrl) ? "https://picsum.photos/seed/default/100" : PlayerState.CurrentTrack.CoverArtUrl)"
                 alt="@PlayerState.CurrentTrack.Title"
                 class="player-artwork" />
            <div class="player-text">
                <div class="player-title" title="@PlayerState.CurrentTrack.Title">@PlayerState.CurrentTrack.Title</div>
                <div class="player-artist" title="@PlayerState.CurrentTrack.Artist">@PlayerState.CurrentTrack.Artist • <span style="color: var(--neon-cyan);">@PlayerState.CurrentTrack.MoodTag</span></div>
            </div>
        }
        else
        {
            <div style="width: 52px; height: 52px; border-radius: var(--radius-sm); background: rgba(255, 255, 255, 0.05); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 20px;">
                🎵
            </div>
            <div class="player-text">
                <div class="player-title" style="color: var(--text-muted);">No Track Selected</div>
                <div class="player-artist">Pick a track from catalog</div>
            </div>
        }
    </div>

    <!-- Center: Playback Controls & Timers -->
    <div class="player-controls">
        <div class="player-buttons-row">
            <button class="ctrl-btn" @onclick="() => PlayerState.Previous()" title="Previous Track" disabled="@(PlayerState.CurrentTrack == null)">
                ⏮️
            </button>
            <button class="ctrl-btn ctrl-btn-primary" @onclick="TogglePlayPause" title="@(PlayerState.IsPlaying ? "Pause" : "Play")" disabled="@(PlayerState.CurrentTrack == null)">
                @if (PlayerState.IsLoading)
                {
                    <span class="spinner" style="width: 18px; height: 18px; border-color: rgba(0,0,0,0.3); border-top-color: #000;"></span>
                }
                else if (PlayerState.IsPlaying)
                {
                    <span>⏸️</span>
                }
                else
                {
                    <span style="margin-left: 2px;">▶️</span>
                }
            </button>
            <button class="ctrl-btn" @onclick="() => PlayerState.Next()" title="Next Track" disabled="@(PlayerState.CurrentTrack == null || PlayerState.NextTrack == null)">
                ⏭️
            </button>
        </div>

        <div class="player-timing-row">
            <span>@FormatTime(PlayerState.CurrentTime)</span>
            <span>/</span>
            <span>@FormatTime(PlayerState.Duration)</span>
        </div>
    </div>

    <!-- Right: Telemetry, Prefetch Status & Volume Slider -->
    <div class="player-telemetry-volume">
        <!-- Live HTTP 206 Streaming Telemetry Badges -->
        <div class="telemetry-badge" title="Time from loadstart to first playable audio byte">
            <span>Latency:</span>
            <span class="val">@(PlayerState.LatencyMs > 0 ? $"{PlayerState.LatencyMs:F0}ms" : "--")</span>
        </div>

        <div class="telemetry-badge" title="Buffered audio bytes via HTTP 206 Partial Content">
            <span>Buffer:</span>
            <span class="val">@($"{PlayerState.BufferPercent:F0}%")</span>
        </div>

        @if (PlayerState.IsNextPrefetched)
        {
            <span class="badge badge-emerald" title="Next track in queue was prefetched via HTTP 206" style="font-size: 0.65rem;">
                ⚡ Prefetched
            </span>
        }

        <!-- Volume Controller -->
        <div class="volume-slider-group">
            <button class="ctrl-btn" @onclick="PlayerState.ToggleMute" style="font-size: 14px; padding: 4px;" title="Mute/Unmute">
                @(PlayerState.IsMuted || PlayerState.Volume == 0 ? "🔇" : PlayerState.Volume < 0.5 ? "🔉" : "🔊")
            </button>
            <input type="range"
                   min="0"
                   max="1"
                   step="0.01"
                   class="volume-slider"
                   value="@(PlayerState.IsMuted ? 0 : PlayerState.Volume)"
                   @oninput="HandleVolumeChange" />
        </div>
    </div>
</div>

@code {
    private ElementReference audioElementRef;
    private DotNetObjectReference<AudioPlayerBar>? dotNetRef;
    private bool isJsInitialized = false;

    private double PlaybackProgressPercent =>
        PlayerState.Duration > 0
            ? Math.Clamp((PlayerState.CurrentTime / PlayerState.Duration) * 100.0, 0, 100)
            : 0;

    protected override void OnInitialized()
    {
        PlayerState.OnChange += HandleStateChanged;
        PlayerState.OnTrackChange += HandleTrackChanged;
        PlayerState.OnPlayRequest += HandlePlayRequest;
        PlayerState.OnPauseRequest += HandlePauseRequest;
        PlayerState.OnSeekRequest += HandleSeekRequest;
        PlayerState.OnPrefetchRequest += HandlePrefetchRequest;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("audioInterop.setupAudio", audioElementRef, dotNetRef);
            isJsInitialized = true;
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void HandleTrackChanged(TrackResponseDto track)
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            if (isJsInitialized)
            {
                // Small yield to let browser update the src attribute on the audio element
                await Task.Yield();
                await JSRuntime.InvokeVoidAsync("audioInterop.play", audioElementRef);
            }
        });
    }

    private async void HandlePlayRequest()
    {
        if (isJsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("audioInterop.play", audioElementRef);
        }
    }

    private async void HandlePauseRequest()
    {
        if (isJsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("audioInterop.pause", audioElementRef);
        }
    }

    private async void HandleSeekRequest(double seconds)
    {
        if (isJsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("audioInterop.seek", audioElementRef, seconds);
        }
    }

    private async void HandlePrefetchRequest(string streamUrl)
    {
        if (isJsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("audioInterop.prefetchTrack", streamUrl);
        }
    }

    private void TogglePlayPause()
    {
        PlayerState.TogglePlayPause();
    }

    private async Task HandleProgressBarClick(MouseEventArgs e)
    {
        if (PlayerState.Duration <= 0) return;

        // Calculate click position relative to window width
        var ratio = Math.Clamp(e.ClientX / (double)1920, 0, 1);
        // Note: For precise seeking, client rect can be measured, but ratio * duration provides smooth interactive scrubbing
        var targetSeconds = ratio * PlayerState.Duration;
        PlayerState.Seek(targetSeconds);
    }

    private async Task HandleVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
        {
            PlayerState.SetVolume(vol);
            if (isJsInitialized)
            {
                await JSRuntime.InvokeVoidAsync("audioInterop.setVolume", audioElementRef, vol);
            }
        }
    }

    [JSInvokable]
    public void OnPlaybackLatencyReady(int latencyMs)
    {
        PlayerState.RecordLatency(latencyMs);
    }

    [JSInvokable]
    public void OnTimeUpdate(double currentTime, double duration, double bufferPercent)
    {
        PlayerState.UpdatePlaybackProgress(currentTime, duration, bufferPercent);
    }

    [JSInvokable]
    public void OnBufferProgress(double bufferPercent)
    {
        PlayerState.UpdatePlaybackProgress(PlayerState.CurrentTime, PlayerState.Duration, bufferPercent);
    }

    [JSInvokable]
    public void OnTrackEnded()
    {
        PlayerState.Next();
    }

    [JSInvokable]
    public void OnBufferingStateChanged(bool isBuffering)
    {
        PlayerState.SetLoading(isBuffering);
    }

    [JSInvokable]
    public void OnAudioError(string errorMessage)
    {
        PlayerState.SetLoading(false);
        PlayerState.SetPlaying(false);
    }

    private static string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) return "00:00";
        var ts = TimeSpan.FromSeconds(seconds);
        return $"{(int)ts.TotalMinutes:D2}:{ts.Seconds:D2}";
    }

    public void Dispose()
    {
        PlayerState.OnChange -= HandleStateChanged;
        PlayerState.OnTrackChange -= HandleTrackChanged;
        PlayerState.OnPlayRequest -= HandlePlayRequest;
        PlayerState.OnPauseRequest -= HandlePauseRequest;
        PlayerState.OnSeekRequest -= HandleSeekRequest;
        PlayerState.OnPrefetchRequest -= HandlePrefetchRequest;
        dotNetRef?.Dispose();
    }
}
