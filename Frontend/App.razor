@* [EDUCATIONAL NOTE - Lab 8 S1 & S2]:
   Blazor Root Application Component:
   1. CascadingAuthenticationState cascades the current student's ClaimsPrincipal down the component hierarchy.
   2. AuthorizeRouteView inspects [Authorize] attributes on routed pages.
   3. NotAuthorized renders an inline prompt encouraging the student to log in. *@

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div style="padding: 40px; text-align: center; max-width: 500px; margin: 40px auto; background: var(--bg-surface-elevated); border-radius: var(--radius-lg); border: 1px solid var(--border-glass);">
                        <div style="font-size: 3rem; margin-bottom: 12px;">🔒</div>
                        <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Access Restricted</h2>
                        <p style="color: var(--text-secondary); margin-bottom: 20px;">
                            You must be authenticated with a student account to access this studio workspace.
                        </p>
                        <a href="auth" class="btn btn-primary">Sign In / Register</a>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <div style="padding: 60px; text-align: center;">
                        <div class="spinner" style="width: 32px; height: 32px; border-width: 3px; border-top-color: var(--neon-cyan);"></div>
                        <p style="color: var(--text-secondary); margin-top: 14px;">Validating student authorization...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div style="padding: 60px; text-align: center;">
                    <h2 style="font-size: 2.2rem; color: var(--neon-magenta); margin-bottom: 10px;">404 - Track Not Found</h2>
                    <p style="color: var(--text-secondary); margin-bottom: 20px;">The audio frequency or route you are tuned to does not exist.</p>
                    <a href="" class="btn btn-primary">Return to Catalog</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
